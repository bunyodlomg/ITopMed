{
  "name": "itopmed",
  "version": "0.1.0",
  "private": true,
  "description": "ITop Med — multi-tenant healthcare management platform",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:check": "tsx scripts/check-i18n.ts",
    "db:start": "tsx scripts/dev-db.ts",
    "dev:demo": "tsx --conditions=react-server scripts/dev-demo.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "admin:create": "tsx --conditions=react-server scripts/create-platform-admin.ts",
    "postinstall": "prisma generate",
    "worker": "tsx --conditions=react-server scripts/worker.ts",
    "backup": "tsx scripts/backup.ts",
    "backup:verify": "tsx scripts/restore-verify.ts",
    "local": "tsx scripts/local.ts",
    "setup": "tsx scripts/setup.ts",
    "app": "tsx scripts/app.ts start",
    "app:stop": "tsx scripts/app.ts stop",
    "app:shortcut": "tsx scripts/app.ts shortcut",
    "app:status": "tsx scripts/app.ts status",
    "app:doctor": "tsx scripts/app.ts doctor",
    "app:firewall": "tsx scripts/app.ts firewall",
    "app:autostart": "tsx scripts/app.ts autostart",
    "docs:pdf": "tsx scripts/docs/build-pdf.ts",
    "package:win": "tsx scripts/package/build-win.ts",
    "package:linux": "tsx scripts/package/build-linux.ts",
    "ui:audit": "tsx scripts/ui-audit.ts",
    "e2e:walkthrough": "tsx scripts/e2e-walkthrough.ts",
    "telegram:setup": "tsx --conditions=react-server scripts/telegram-setup.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "fflate": "0.8.2",
    "lucide-react": "^1.71.0",
    "next": "^16.4.6",
    "next-intl": "^4.14.10",
    "node-forge": "^1.3.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "use-intl": "^4.14.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/node-forge": "^1.3.14",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "dotenv": "^18.0.10",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "playwright-core": "^1.56.1",
    "postject": "^1.0.0-alpha.6",
    "prisma": "^7.10.1",
    "rcedit": "^4.0.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
