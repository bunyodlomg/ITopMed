// ITop Med — relational schema.
//
// Conventions (see docs/DATABASE-DESIGN.md):
// * UUIDv7 primary keys generated by the application.
// * Every clinic-owned table carries `tenantId` and is protected by PostgreSQL
//   Row-Level Security (policies live in the SQL migrations, not here).
// * Clinical tables are added in later migrations and are NEVER granted to the
//   platform database role.
// * Locales are stored as BCP-47 strings constrained by CHECK constraints:
//   'uz-Latn' | 'uz-Cyrl' | 'ru' | 'en'.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Platform (ITop Med staff) ─────────────────────

enum PlatformRole {
  SUPER_ADMIN
  PLATFORM_ADMIN
  /// Manages only the clinics of one network (franchise / group). Never sees clinical data.
  NETWORK_ADMIN
  SUPPORT
  BILLING
  READ_ONLY
}

enum AccountStatus {
  INVITED
  ACTIVE
  DISABLED
}

model PlatformUser {
  id               String        @id @db.Uuid
  /// Sign-in name (lowercase). Existing accounts were given their email as login.
  username         String        @unique
  email            String?       @unique /// legacy, no longer written or shown
  fullName         String
  passwordHash     String?
  role             PlatformRole
  /// Set only for NETWORK_ADMIN: the one network this person manages.
  networkId        String?       @db.Uuid
  status           AccountStatus @default(INVITED)
  locale           String        @default("uz-Latn")
  /// Telegram user id, linked by the person themselves (website login or bot); null = not linked.
  telegramId       BigInt?       @unique
  telegramLinkedAt DateTime?
  failedLoginCount Int           @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  network         Network?             @relation(fields: [networkId], references: [id])
  sessions        PlatformSession[]
  invitationsSent PlatformInvitation[] @relation("PlatformInviter")
  tenantsCreated  Tenant[]
  supportGrants   SupportAccessGrant[]

  @@index([networkId])
}

model PlatformSession {
  /// SHA-256 (hex) of the session token. The raw token only exists in the cookie.
  id             String    @id
  platformUserId String    @db.Uuid
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  lastSeenAt     DateTime  @default(now())
  revokedAt      DateTime?
  ipHash         String?
  userAgent      String?

  user PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@index([platformUserId])
}

model PlatformInvitation {
  id          String           @id @db.Uuid
  email       String?
  fullName    String
  role        PlatformRole
  networkId   String?          @db.Uuid
  tokenHash   String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  invitedById String           @db.Uuid
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime         @default(now())

  invitedBy PlatformUser @relation("PlatformInviter", fields: [invitedById], references: [id])
  network   Network?     @relation(fields: [networkId], references: [id])

  @@index([email])
}

/// A group of clinics with one owner company (franchise, chain, holding). Platform-only table:
/// its network admins manage these clinics in the console; clinical data stays inside each clinic.
model Network {
  id           String    @id @db.Uuid
  name         String
  contactName  String?
  contactPhone String?
  createdById  String?   @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  archivedAt   DateTime?

  tenants     Tenant[]
  admins      PlatformUser[]
  invitations PlatformInvitation[]
}

// ───────────────────────────── Tenancy & subscriptions ───────────────────────

enum TenantStatus {
  PROVISIONING
  TRIAL
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model Tenant {
  id               String       @id @db.Uuid
  slug             String       @unique
  name             String
  legalName        String?
  /// Uzbekistan taxpayer identification number (STIR/INN) of the legal entity.
  taxId            String?
  status           TenantStatus @default(PROVISIONING)
  defaultLocale    String       @default("uz-Latn")
  timezone         String       @default("Asia/Tashkent")
  currency         String       @default("UZS")
  countryCode      String       @default("UZ")
  /// Where this tenant's data must be hosted. Changing it requires a documented legal assessment.
  dataResidency    String       @default("UZ")
  contactEmail     String?
  contactPhone     String?
  address          String?
  /// Kind of practice (setup presets). Clinics can change it any time.
  practiceType     PracticeType @default(MULTI_SPECIALTY)
  /// Set when the owner finished the setup assistant.
  setupCompletedAt DateTime?
  /// Letterhead on printed documents: small logo (data URL, PNG/JPEG/WebP) and licence line.
  logoDataUrl      String?
  licenseText      String?
  /// Map link (https) printed as a QR code on the letterhead so patients find the clinic.
  locationUrl     String?
  /// Setup chosen by the platform when the clinic was created; applied when the owner first opens the clinic.
  setupPreset      Json?
  /// Network (franchise / group of clinics) this clinic belongs to, if any.
  networkId        String?      @db.Uuid
  createdById      String?      @db.Uuid
  activatedAt      DateTime?
  suspendedAt      DateTime?
  suspensionReason String?
  archivedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  createdBy            PlatformUser?           @relation(fields: [createdById], references: [id])
  network              Network?                @relation(fields: [networkId], references: [id])
  branches             Branch[]
  departments          Department[]
  memberships          Membership[]
  roles                Role[]
  invitations          Invitation[]
  modules              TenantModule[]
  subscription         Subscription?
  clinicInvoices       ClinicInvoice[]
  clinicPayments       ClinicPayment[]
  supportGrants        SupportAccessGrant[]
  rooms                Room[]
  services             Service[]
  doctorProfiles       DoctorProfile[]
  clinicPolicy         ClinicPolicy?
  telegramBot          TelegramBot?
  templates            ClinicTemplate[]
  telegramLinks        TelegramLink[]
  telegramLinkCodes    TelegramLinkCode[]
  prescriptions        Prescription[]
  workSchedules        WorkSchedule[]
  scheduleExceptions   ScheduleException[]
  doctorServices       DoctorService[]
  patients             Patient[]
  patientIdentifiers   PatientIdentifier[]
  patientConsents      PatientConsent[]
  appointments         Appointment[]
  encounters           Encounter[]
  clinicalNotes        ClinicalNote[]
  noteAmendments       ClinicalNoteAmendment[]
  diagnoses            Diagnosis[]
  allergies            Allergy[]
  vitalSigns           VitalSign[]
  patientHistories     PatientHistory[]
  nursingRecords       NursingRecord[]
  diagnosticResults    DiagnosticResult[]
  diagnosticFiles      DiagnosticFile[]
  invoices             Invoice[]
  invoiceLines         InvoiceLine[]
  payments             Payment[]
  refunds              Refund[]
  cashShifts           CashShift[]
  expenses             Expense[]
  labAnalytes          LabAnalyte[]
  labOrders            LabOrder[]
  labOrderItems        LabOrderItem[]
  labResults           LabResult[]
  patientAccounts      PatientAccount[]
  patientSessions      PatientSession[]
  inventoryItems       InventoryItem[]
  suppliers            Supplier[]
  stockBatches         StockBatch[]
  stockMovements       StockMovement[]
  staffProfiles        StaffProfile[]
  staffCredentials     StaffCredential[]
  staffLeaves          StaffLeave[]
  notifications        Notification[]
  notificationSettings NotificationSettings?
  dentalChart          DentalChartEntry[]
  benefitCategories    BenefitCategory[]
  servicePackages      ServicePackage[]
  servicePackageItems  ServicePackageItem[]
  displayScreens       DisplayScreen[]
  dispensaryPlans      DispensaryPlan[]
  patientReadings      PatientReading[]
  visitCheckIns        VisitCheckIn[]

  @@index([status])
  @@index([networkId])
}

model Branch {
  id         String    @id @db.Uuid
  tenantId   String    @db.Uuid
  name       String
  code       String?
  address    String?
  phone      String?
  isMain     Boolean   @default(false)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  departments    Department[]
  members        MembershipBranch[]
  rooms          Room[]
  schedules      WorkSchedule[]
  appointments   Appointment[]
  invoices       Invoice[]
  payments       Payment[]
  cashShifts     CashShift[]
  expenses       Expense[]
  labOrders      LabOrder[]
  stockBatches   StockBatch[]
  stockMovements StockMovement[]
  displayScreens DisplayScreen[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Department {
  id         String    @id @db.Uuid
  tenantId   String    @db.Uuid
  branchId   String?   @db.Uuid
  name       String
  specialty  String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch   Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  services Service[]
  doctors  DoctorProfile[]
  staff    StaffProfile[]

  @@unique([tenantId, branchId, name])
  @@index([tenantId])
}

model Plan {
  id                String   @id @db.Uuid
  code              String   @unique
  /// Localised display names: { "uz-Latn": "...", "uz-Cyrl": "...", "ru": "...", "en": "..." }
  name              Json
  priceMonthlyMinor BigInt   @default(0)
  currency          String   @default("UZS")
  maxUsers          Int?
  maxBranches       Int?
  maxStorageMb      Int?
  /// Module keys included in the plan (see src/server/modules/catalog.ts)
  modules           String[]
  trialDays         Int      @default(14)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subscriptions Subscription[]
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

model Subscription {
  id                 String             @id @db.Uuid
  tenantId           String             @unique @db.Uuid
  planId             String             @db.Uuid
  status             SubscriptionStatus
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAt           DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plan   Plan   @relation(fields: [planId], references: [id])
}

model TenantModule {
  tenantId    String   @db.Uuid
  moduleKey   String
  enabled     Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([tenantId, moduleKey])
}

// ───────────────────────────── Clinic identity & access ──────────────────────

model User {
  id               String        @id @db.Uuid
  /// Sign-in name (lowercase). Existing accounts were given their email as login.
  username         String        @unique
  email            String?       @unique /// legacy, no longer written or shown
  phone            String?
  fullName         String
  passwordHash     String?
  status           AccountStatus @default(INVITED)
  /// Personal UI language; null = follow the clinic default.
  locale           String?
  /// Telegram user id, linked by the person themselves (website login or bot); null = not linked.
  telegramId       BigInt?       @unique
  telegramLinkedAt DateTime?
  failedLoginCount Int           @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  sessions       Session[]
  memberships    Membership[]
  passwordResets PasswordReset[]
}

/// Single-use password reset (link sent by the clinic's Telegram bot). Only the SHA-256 of the token is stored.
model PasswordReset {
  id        String    @id @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  ipHash    String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  /// SHA-256 (hex) of the session token.
  id             String    @id
  userId         String    @db.Uuid
  /// Clinic currently selected in this session (switchable among memberships).
  activeTenantId String?   @db.Uuid
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  lastSeenAt     DateTime  @default(now())
  revokedAt      DateTime?
  ipHash         String?
  userAgent      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

model Membership {
  id          String           @id @db.Uuid
  tenantId    String           @db.Uuid
  userId      String           @db.Uuid
  status      MembershipStatus @default(INVITED)
  jobTitle    String?
  /// When false the member is restricted to the branches in MembershipBranch.
  allBranches Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user          User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles         MembershipRole[]
  branches      MembershipBranch[]
  doctorProfile DoctorProfile?
  staffProfile  StaffProfile?
  credentials   StaffCredential[]
  leaves        StaffLeave[]

  @@unique([tenantId, userId])
  @@index([userId])
}

model Role {
  id        String   @id @db.Uuid
  tenantId  String   @db.Uuid
  /// Stable key, e.g. "clinic_owner", "doctor". Custom roles use "custom_*".
  key       String
  /// Custom display name; system roles are translated from the message catalog.
  name      String?
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  members     MembershipRole[]

  @@unique([tenantId, key])
}

model RolePermission {
  tenantId   String @db.Uuid
  roleId     String @db.Uuid
  permission String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@index([tenantId])
}

model MembershipRole {
  tenantId     String @db.Uuid
  membershipId String @db.Uuid
  roleId       String @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([membershipId, roleId])
  @@index([tenantId])
}

model MembershipBranch {
  tenantId     String @db.Uuid
  membershipId String @db.Uuid
  branchId     String @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([membershipId, branchId])
  @@index([tenantId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model Invitation {
  id                      String           @id @db.Uuid
  tenantId                String           @db.Uuid
  email                   String?
  fullName                String
  roleKeys                String[]
  /// SHA-256 (hex) of the invitation token (internal: created and accepted on the server).
  tokenHash               String           @unique
  status                  InvitationStatus @default(PENDING)
  expiresAt               DateTime
  invitedByPlatformUserId String?          @db.Uuid
  invitedByUserId         String?          @db.Uuid
  acceptedAt              DateTime?
  acceptedUserId          String?          @db.Uuid
  revokedAt               DateTime?
  sendCount               Int              @default(1)
  lastSentAt              DateTime         @default(now())
  createdAt               DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, email])
}

// ───────────────────────────── Support access (break-glass) ──────────────────

enum SupportAccessScope {
  /// Clinic settings, users, configuration. No patient data.
  CONFIGURATION
  /// Operational data (schedules, invoices) without clinical content.
  OPERATIONAL
  /// Read-only clinical access. Requires clinic-owner approval and is fully audited.
  CLINICAL_READ
}

enum SupportAccessStatus {
  REQUESTED
  APPROVED
  DENIED
  REVOKED
  EXPIRED
}

model SupportAccessGrant {
  id              String              @id @db.Uuid
  tenantId        String              @db.Uuid
  platformUserId  String              @db.Uuid
  /// Snapshot of who asked, so the clinic can see it without access to platform tables.
  requesterName   String              @default("")
  requesterEmail  String              @default("")
  scope           SupportAccessScope
  reason          String
  ticketRef       String?
  status          SupportAccessStatus @default(REQUESTED)
  durationMinutes Int
  requestedAt     DateTime            @default(now())
  decidedAt       DateTime?
  decidedByUserId String?             @db.Uuid
  startsAt        DateTime?
  expiresAt       DateTime?
  revokedAt       DateTime?

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  platformUser PlatformUser @relation(fields: [platformUserId], references: [id])

  @@index([tenantId, status])
}

// ───────────────────────────── Audit ─────────────────────────────────────────

enum AuditActorType {
  PLATFORM_USER
  USER
  SYSTEM
  ANONYMOUS
  PATIENT
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

/// Append-only, hash-chained audit trail. UPDATE/DELETE are rejected by a
/// trigger and `prevHash`/`hash` are computed by the database on insert.
/// `metadata` must never contain clinical content or secrets.
model AuditEvent {
  id         String         @id @db.Uuid
  seq        BigInt         @unique @default(autoincrement())
  tenantId   String?        @db.Uuid
  actorType  AuditActorType
  actorId    String?        @db.Uuid
  action     String
  entityType String?
  entityId   String?
  outcome    AuditOutcome   @default(SUCCESS)
  ipHash     String?
  userAgent  String?
  requestId  String?
  metadata   Json           @default("{}")
  prevHash   String?
  hash       String?
  createdAt  DateTime       @default(now())

  @@index([tenantId, createdAt])
  @@index([actorId, createdAt])
  @@index([action])
}

// ───────────────────────────── Clinic resources & scheduling (Phase 5) ─────────

enum RoomKind {
  CONSULTATION
  PROCEDURE
  LABORATORY
  IMAGING
  WARD
  OTHER
}

model Room {
  id         String    @id @db.Uuid
  tenantId   String    @db.Uuid
  branchId   String    @db.Uuid
  name       String
  kind       RoomKind  @default(CONSULTATION)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch       Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  schedules    WorkSchedule[]
  appointments Appointment[]

  @@unique([tenantId, branchId, name])
  @@index([tenantId])
}

enum ServiceKind {
  CONSULTATION
  PROCEDURE
  LAB_TEST
  IMAGING
  OTHER
}

/// Billable medical service. Prices are integer minor units (ISO 4217; UZS has 2).
/// Invoices (Phase 7) snapshot the price, so a later change never alters history.
model Service {
  id              String      @id @db.Uuid
  tenantId        String      @db.Uuid
  code            String
  name            String
  kind            ServiceKind @default(CONSULTATION)
  departmentId    String?     @db.Uuid
  durationMinutes Int         @default(20)
  priceMinor      BigInt
  currency        String      @default("UZS")
  archivedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  department          Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  doctors             DoctorService[]
  appointments        Appointment[]
  invoiceLines        InvoiceLine[]
  labAnalytes         LabAnalyte[]
  labItems            LabOrderItem[]
  servicePackageItems ServicePackageItem[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

/// Practitioner details for a clinic member who holds a doctor role.
model DoctorProfile {
  id                   String    @id @db.Uuid
  tenantId             String    @db.Uuid
  membershipId         String    @unique @db.Uuid
  /// Key from src/server/scheduling/specialties.ts (translated in the UI).
  specialty            String
  departmentId         String?   @db.Uuid
  licenseNumber        String?
  defaultSlotMinutes   Int       @default(20)
  /// Minutes kept free after each appointment (0–30) so the queue does not drift; slots step by slot + buffer.
  bufferMinutes        Int       @default(0)
  /// Doctor's share (%) of the money received for their patients; null = not set.
  commissionPercent    Int?
  acceptsOnlineBooking Boolean   @default(false)
  /// Room / cabinet named when the patient is called (e.g. "3-xona").
  cabinet              String?
  /// Printed on conclusions for patients' questions (optional).
  contactPhone         String?
  contactTelegram      String?
  archivedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membership      Membership          @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  department      Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  schedules       WorkSchedule[]
  exceptions      ScheduleException[]
  services        DoctorService[]
  appointments    Appointment[]
  encounters      Encounter[]
  labOrders       LabOrder[]
  dispensaryPlans DispensaryPlan[]

  @@index([tenantId])
}

model DoctorService {
  tenantId        String @db.Uuid
  doctorProfileId String @db.Uuid
  serviceId       String @db.Uuid

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  doctor  DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  service Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([doctorProfileId, serviceId])
  @@index([tenantId])
}

/// Recurring weekly working hours in the clinic local time zone.
/// weekday: 1 = Monday ... 7 = Sunday (ISO 8601). Minutes since local midnight.
model WorkSchedule {
  id              String   @id @db.Uuid
  tenantId        String   @db.Uuid
  doctorProfileId String   @db.Uuid
  branchId        String   @db.Uuid
  roomId          String?  @db.Uuid
  weekday         Int
  startMinute     Int
  endMinute       Int
  createdAt       DateTime @default(now())

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  doctor DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  branch Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  room   Room?         @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([tenantId, doctorProfileId, weekday])
}

/// A date on which the weekly schedule does not apply. The reason is a category
/// only, never free text: staff health information is sensitive.
enum ScheduleExceptionKind {
  DAY_OFF
  VACATION
  TRAINING
  OTHER_ABSENCE
}

model ScheduleException {
  id              String                @id @db.Uuid
  tenantId        String                @db.Uuid
  doctorProfileId String                @db.Uuid
  /// Local calendar date in the clinic time zone.
  date            DateTime              @db.Date
  kind            ScheduleExceptionKind
  /// Set when the day off comes from an HR leave record (removed when the leave is cancelled).
  leaveId         String?               @db.Uuid
  createdAt       DateTime              @default(now())

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  doctor DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  leave  StaffLeave?   @relation(fields: [leaveId], references: [id], onDelete: Restrict)

  @@unique([doctorProfileId, date])
  @@index([tenantId, date])
}

// ───────────────────────────── Patients (Phase 6) ─────────────────────────────

enum Sex {
  MALE
  FEMALE
  UNKNOWN
}

enum PatientStatus {
  ACTIVE
  ARCHIVED
  MERGED
}

/// Demographics only. Clinical data lives in separate EMR tables with stricter access.
enum ReferralSource {
  SELF
  DOCTOR
  ADVERTISING
  OTHER
}

/// Privileged patient categories with an automatic discount (set by the clinic owner/admin).
/// A waiting-room screen (TV) of one branch: opened by a secret link, no sign-in.
model DisplayScreen {
  id          String    @id @db.Uuid
  tenantId    String    @db.Uuid
  branchId    String    @db.Uuid
  name        String
  /// SHA-256 of the secret in the screen's link; the secret itself is never stored.
  tokenHash   String    @unique
  voice       Boolean   @default(true)
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([tenantId])
}

model BenefitCategory {
  id              String    @id @db.Uuid
  tenantId        String    @db.Uuid
  name            String
  discountPercent Int
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, name])
}

/// A set of services sold together; when all of them are billed at once, the package discount applies.
model ServicePackage {
  id              String               @id @db.Uuid
  tenantId        String               @db.Uuid
  name            String
  discountPercent Int
  archivedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  items           ServicePackageItem[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, name])
}

model ServicePackageItem {
  id        String @id @db.Uuid
  tenantId  String @db.Uuid
  packageId String @db.Uuid
  serviceId String @db.Uuid

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  package ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([packageId, serviceId])
  @@index([tenantId])
}

enum DiscountKind {
  MANUAL
  BENEFIT
  PACKAGE
  FOLLOW_UP
  FOLLOW_UP_EXCEPTION
}

model Patient {
  id                String          @id @db.Uuid
  tenantId          String          @db.Uuid
  /// Clinic-local medical record number, e.g. "P-000042".
  mrn               String
  lastName          String
  firstName         String
  middleName        String?
  birthDate         DateTime        @db.Date
  /// Only the year of birth is known (stored as 1 January of that year).
  birthYearOnly     Boolean         @default(false)
  sex               Sex
  phone             String?
  email             String?
  address           String?
  preferredLocale   String?
  status            PatientStatus   @default(ACTIVE)
  mergedIntoId      String?         @db.Uuid
  /// Who sent the patient (first visit): self, a doctor, advertising, other.
  referralSource    ReferralSource?
  /// Doctor's name or advertising channel (no clinical content).
  referralDetail    String?
  /// Privileged category (e.g. veteran, disabled person): automatic discount set by the clinic.
  benefitCategoryId String?         @db.Uuid
  createdById       String          @db.Uuid
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  identifiers       PatientIdentifier[]
  consents          PatientConsent[]
  appointments      Appointment[]
  encounters        Encounter[]
  notes             ClinicalNote[]
  diagnoses         Diagnosis[]
  allergies         Allergy[]
  vitals            VitalSign[]
  history           PatientHistory?
  nursingRecords    NursingRecord[]
  diagnostics       DiagnosticResult[]
  prescriptions     Prescription[]
  telegramLinks     TelegramLink[]
  telegramLinkCodes TelegramLinkCode[]
  invoices          Invoice[]
  labOrders         LabOrder[]
  portalAccount     PatientAccount?
  dispenses         StockMovement[]
  notifications     Notification[]
  dentalChart       DentalChartEntry[]
  dispensaryPlans   DispensaryPlan[]
  readings          PatientReading[]
  visitCheckIns     VisitCheckIn[]

  @@unique([tenantId, mrn])
  @@index([tenantId, lastName, firstName])
  @@index([tenantId, birthDate])
  @@index([tenantId, phone])
}

enum IdentifierType {
  PINFL
  PASSPORT
  BIRTH_CERTIFICATE
  INSURANCE
  OTHER
}

model PatientIdentifier {
  id        String         @id @db.Uuid
  tenantId  String         @db.Uuid
  patientId String         @db.Uuid
  type      IdentifierType
  value     String
  createdAt DateTime       @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@unique([tenantId, type, value])
  @@index([tenantId, patientId])
}

enum ConsentPurpose {
  SMS_REMINDERS
  TELEGRAM_NOTIFICATIONS
  EMAIL_NOTIFICATIONS
  MARKETING
  HEALTH_DATA_EXCHANGE
  PATIENT_PORTAL
}

enum ConsentMethod {
  PAPER_SIGNED
  VERBAL_RECORDED
  PORTAL
}

/// Consent is recorded per purpose. Care itself is not based on consent here;
/// see docs/SECURITY-AND-PRIVACY.md (legal basis per purpose).
model PatientConsent {
  id           String         @id @db.Uuid
  tenantId     String         @db.Uuid
  patientId    String         @db.Uuid
  purpose      ConsentPurpose
  method       ConsentMethod
  grantedAt    DateTime       @default(now())
  withdrawnAt  DateTime?
  recordedById String         @db.Uuid

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([tenantId, patientId, purpose])
}

// ───────────────────────────── Appointments & queue ───────────────────────────

enum AppointmentStatus {
  BOOKED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  FRONT_DESK
  PHONE
  WALK_IN
  PORTAL
}

enum CancellationReason {
  PATIENT_REQUEST
  CLINIC_RESCHEDULE
  DOCTOR_UNAVAILABLE
  DUPLICATE
  OTHER
}

/// Overlapping active appointments for the same doctor are rejected by a
/// database exclusion constraint (see migration), not only by application code.
model Appointment {
  id                 String              @id @db.Uuid
  tenantId           String              @db.Uuid
  patientId          String              @db.Uuid
  doctorProfileId    String              @db.Uuid
  branchId           String              @db.Uuid
  roomId             String?             @db.Uuid
  serviceId          String?             @db.Uuid
  startsAt           DateTime
  endsAt             DateTime
  status             AppointmentStatus   @default(BOOKED)
  source             AppointmentSource   @default(FRONT_DESK)
  /// Administrative note only (e.g. "prefers morning"). Never clinical details.
  adminNote          String?
  /// Daily per-branch queue number, assigned at check-in.
  queueNumber        Int?
  /// The doctor pressed "Next patient": shown on the waiting-room screen (and spoken).
  calledAt           DateTime?
  calledCount        Int                 @default(0)
  checkedInAt        DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  /// Set when the visit was moved to another time (the move itself is in the audit log).
  rescheduledAt      DateTime?
  rescheduleCount    Int                 @default(0)
  cancellationReason CancellationReason?
  /// Staff member who booked it; empty when the patient booked online in the portal (source = PORTAL).
  createdById        String?             @db.Uuid
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient   Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor    DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Restrict)
  branch    Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  room      Room?         @relation(fields: [roomId], references: [id], onDelete: SetNull)
  service   Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  encounter Encounter?
  invoice   Invoice?

  @@index([tenantId, startsAt])
  @@index([tenantId, doctorProfileId, startsAt])
  @@index([tenantId, patientId])
}

// ───────────────────────────── Electronic medical record ──────────────────────

enum EncounterStatus {
  OPEN
  CLOSED
}

model Encounter {
  id              String          @id @db.Uuid
  tenantId        String          @db.Uuid
  patientId       String          @db.Uuid
  doctorProfileId String          @db.Uuid
  appointmentId   String?         @unique @db.Uuid
  branchId        String          @db.Uuid
  status          EncounterStatus @default(OPEN)
  startedAt       DateTime        @default(now())
  closedAt        DateTime?
  /// Next visit agreed with the patient (printed on the conclusion).
  nextVisitDate   DateTime?       @db.Date
  createdAt       DateTime        @default(now())

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient       Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor        DoctorProfile      @relation(fields: [doctorProfileId], references: [id], onDelete: Restrict)
  appointment   Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  notes         ClinicalNote[]
  diagnoses     Diagnosis[]
  vitals        VitalSign[]
  prescriptions Prescription[]
  labOrders     LabOrder[]
  dentalChart   DentalChartEntry[]
  checkIn       VisitCheckIn?

  @@index([tenantId, patientId, startedAt])
}

enum NoteStatus {
  DRAFT
  SIGNED
}

/// Structured consultation note. Once SIGNED it is immutable (trigger);
/// corrections are appended as ClinicalNoteAmendment rows.
model ClinicalNote {
  id          String     @id @db.Uuid
  tenantId    String     @db.Uuid
  encounterId String     @db.Uuid
  patientId   String     @db.Uuid
  authorId    String     @db.Uuid
  status      NoteStatus @default(DRAFT)
  complaints  String     @default("")
  history     String     @default("")
  examination String     @default("")
  assessment  String     @default("")
  plan        String     @default("")
  signedAt    DateTime?
  signedById  String?    @db.Uuid
  /// SHA-256 of the canonical signed content (tamper evidence).
  contentHash String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tenant     Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  encounter  Encounter               @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  patient    Patient                 @relation(fields: [patientId], references: [id], onDelete: Restrict)
  amendments ClinicalNoteAmendment[]

  @@index([tenantId, patientId])
}

model ClinicalNoteAmendment {
  id          String   @id @db.Uuid
  tenantId    String   @db.Uuid
  noteId      String   @db.Uuid
  authorId    String   @db.Uuid
  reason      String
  content     String
  contentHash String
  createdAt   DateTime @default(now())

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  note   ClinicalNote @relation(fields: [noteId], references: [id], onDelete: Restrict)

  @@index([tenantId, noteId])
}

enum DiagnosisKind {
  PRIMARY
  /// Concomitant disease ("hamroh kasallik").
  SECONDARY
  /// Complication of the main disease ("asorati").
  COMPLICATION
}

enum ClinicalStatus {
  ACTIVE
  RESOLVED
  ENTERED_IN_ERROR
}

model Diagnosis {
  id           String         @id @db.Uuid
  tenantId     String         @db.Uuid
  patientId    String         @db.Uuid
  encounterId  String?        @db.Uuid
  /// ICD-10 code as used in Uzbekistan, e.g. "I10" or "J06.9".
  icd10Code    String
  description  String
  kind         DiagnosisKind  @default(PRIMARY)
  /// Stage or degree ("II daraja", "NYHA III", "G3a").
  stage        String?
  status       ClinicalStatus @default(ACTIVE)
  recordedById String         @db.Uuid
  recordedAt   DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter Encounter? @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  @@index([tenantId, patientId])
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
  UNKNOWN
}

model Allergy {
  id           String          @id @db.Uuid
  tenantId     String          @db.Uuid
  patientId    String          @db.Uuid
  substance    String
  reaction     String?
  severity     AllergySeverity @default(UNKNOWN)
  status       ClinicalStatus  @default(ACTIVE)
  recordedById String          @db.Uuid
  recordedAt   DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([tenantId, patientId])
}

enum VitalKind {
  SYSTOLIC_BP
  DIASTOLIC_BP
  HEART_RATE
  RESPIRATORY_RATE
  TEMPERATURE
  SPO2
  WEIGHT
  HEIGHT
  BLOOD_GLUCOSE
  /// Blood pressure on the left arm (SYSTOLIC_BP / DIASTOLIC_BP are the right arm or the only measurement).
  SYSTOLIC_BP_LEFT
  DIASTOLIC_BP_LEFT
  WAIST
}

enum Pregnancy {
  NO
  YES
  UNKNOWN
}

enum DiabetesType {
  NO
  TYPE1
  TYPE2
  OTHER
}

enum SmokingStatus {
  NEVER
  FORMER
  CURRENT
}

/// Diagnostic study types. New devices / studies are added here and in src/lib/diagnostics.ts.
enum DiagnosticKind {
  ECG
  ECHO
  ULTRASOUND
  HOLTER
  ABPM
  STRESS_TEST
  OTHER
}

/// Result of a diagnostic study (entered by hand from the device or paper today; files attached).
model DiagnosticResult {
  id               String         @id @db.Uuid
  tenantId         String         @db.Uuid
  patientId        String         @db.Uuid
  encounterId      String?        @db.Uuid
  kind             DiagnosticKind
  /// Short title, e.g. "UZI: buyraklar".
  title            String
  /// Measured values by field key (see src/lib/diagnostics.ts).
  data             Json
  conclusion       String
  /// Copy of the clinic template used (fields, normals, report text) - past reports never change.
  templateSnapshot Json?
  performedById    String         @db.Uuid
  performedAt      DateTime       @default(now())
  enteredInErrorAt DateTime?

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient Patient          @relation(fields: [patientId], references: [id], onDelete: Restrict)
  files   DiagnosticFile[]

  @@index([tenantId, patientId, performedAt])
  @@index([encounterId])
}

/// An image or PDF attached to a diagnostic result (ultrasound pictures, ECG scans, device reports).
model DiagnosticFile {
  id           String   @id @db.Uuid
  tenantId     String   @db.Uuid
  resultId     String   @db.Uuid
  fileName     String
  mimeType     String
  sizeBytes    Int
  sha256       String
  content      Bytes
  uploadedById String   @db.Uuid
  createdAt    DateTime @default(now())

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  result DiagnosticResult @relation(fields: [resultId], references: [id], onDelete: Restrict)

  @@index([tenantId, resultId])
}

enum NursingKind {
  FIRST_AID
  MEDICATION
  NOTE
}

/// Structured anamnesis of a patient (one row per patient, updated over time). Drug allergies are in Allergy.
model PatientHistory {
  patientId                 String         @id @db.Uuid
  tenantId                  String         @db.Uuid
  pregnancy                 Pregnancy?
  pregnancyWeeks            Int?
  priorMyocardialInfarction Boolean?
  diabetes                  DiabetesType?
  smoking                   SmokingStatus?
  hypertensionYears         Int?
  hereditary                String?
  surgeries                 String?
  otherNotes                String?
  updatedById               String         @db.Uuid
  updatedAt                 DateTime       @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([tenantId])
}

/// Triage / nurse's room: first aid given, medication given, notes (append-only).
model NursingRecord {
  id            String      @id @db.Uuid
  tenantId      String      @db.Uuid
  patientId     String      @db.Uuid
  appointmentId String?     @db.Uuid
  kind          NursingKind
  text          String
  drug          String?
  dose          String?
  route         String?
  recordedById  String      @db.Uuid
  recordedAt    DateTime    @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([tenantId, patientId, recordedAt])
}

/// One measured value. Units are fixed per kind (UCUM) in src/server/emr/vitals.ts.
model VitalSign {
  id           String    @id @db.Uuid
  tenantId     String    @db.Uuid
  patientId    String    @db.Uuid
  encounterId  String?   @db.Uuid
  kind         VitalKind
  value        Decimal   @db.Decimal(7, 2)
  unit         String
  measuredAt   DateTime
  recordedById String    @db.Uuid
  createdAt    DateTime  @default(now())

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter Encounter? @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  @@index([tenantId, patientId, measuredAt])
}

// ───────────────────────────── Billing & finance (Phase 7) ────────────────────
// All money: BigInt minor units (tiyin / cents) + ISO 4217 currency.

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum VoidReason {
  CREATED_IN_ERROR
  DUPLICATE
  SERVICE_CANCELLED
  OTHER
}

/// Lines can change only while DRAFT (trigger). Totals are recomputed by the
/// service in the same transaction and guarded by CHECK constraints.
model Invoice {
  id               String        @id @db.Uuid
  tenantId         String        @db.Uuid
  /// Assigned when issued: INV-<year>-<6 digits>, sequential per clinic and year.
  number           String?
  patientId        String        @db.Uuid
  branchId         String        @db.Uuid
  appointmentId    String?       @unique @db.Uuid
  status           InvoiceStatus @default(DRAFT)
  currency         String
  subtotalMinor    BigInt        @default(0)
  discountMinor    BigInt        @default(0)
  totalMinor       BigInt        @default(0)
  /// Payments minus refunds.
  paidMinor        BigInt        @default(0)
  issuedAt         DateTime?
  voidedAt         DateTime?
  /// The cashier accepted that the rest stays as the patient's debt (lets the desk print final documents).
  debtApprovedById String?       @db.Uuid
  debtApprovedAt   DateTime?
  voidReason       VoidReason?
  createdById      String        @db.Uuid
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient     Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  branch      Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  appointment Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  lines       InvoiceLine[]
  payments    Payment[]
  refunds     Refund[]

  @@unique([tenantId, number])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, patientId])
}

model InvoiceLine {
  id                   String        @id @db.Uuid
  tenantId             String        @db.Uuid
  invoiceId            String        @db.Uuid
  serviceId            String?       @db.Uuid
  /// Snapshot of the service name at billing time.
  description          String
  quantity             Int
  unitPriceMinor       BigInt
  discountMinor        BigInt        @default(0)
  /// Why the discount was given (required when the clinic policy says so).
  discountReason       String?
  /// Where the discount came from: staff (MANUAL) or a clinic rule (benefit, package, free follow-up).
  discountKind         DiscountKind?
  /// Free follow-up outside the free period: who allowed it.
  discountApprovedById String?       @db.Uuid
  /// Who added the line (accountability for discounts).
  createdById          String?       @db.Uuid
  totalMinor           BigInt
  createdAt            DateTime      @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([tenantId, invoiceId])
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  PAYME
  CLICK
  UZUM
  OTHER
}

model Payment {
  id             String        @id @db.Uuid
  tenantId       String        @db.Uuid
  invoiceId      String        @db.Uuid
  branchId       String        @db.Uuid
  amountMinor    BigInt
  currency       String
  method         PaymentMethod
  /// Terminal / transaction reference (entered manually until provider integrations exist).
  externalRef    String?
  /// Client-generated per form render: a double click or retry cannot pay twice.
  idempotencyKey String
  cashShiftId    String?       @db.Uuid
  refundedMinor  BigInt        @default(0)
  receivedById   String        @db.Uuid
  receivedAt     DateTime      @default(now())

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoice   Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  branch    Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  cashShift CashShift? @relation(fields: [cashShiftId], references: [id], onDelete: Restrict)
  refunds   Refund[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, receivedAt])
  @@index([tenantId, invoiceId])
}

enum RefundReason {
  SERVICE_NOT_PROVIDED
  OVERPAYMENT
  PATIENT_REQUEST
  BILLING_ERROR
  OTHER
}

model Refund {
  id             String       @id @db.Uuid
  tenantId       String       @db.Uuid
  paymentId      String       @db.Uuid
  invoiceId      String       @db.Uuid
  amountMinor    BigInt
  reason         RefundReason
  idempotencyKey String
  cashShiftId    String?      @db.Uuid
  createdById    String       @db.Uuid
  createdAt      DateTime     @default(now())

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  payment   Payment    @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoice   Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  cashShift CashShift? @relation(fields: [cashShiftId], references: [id], onDelete: Restrict)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt])
}

enum CashShiftStatus {
  OPEN
  CLOSED
}

/// One open shift per cashier and branch (partial unique index in SQL).
model CashShift {
  id                String          @id @db.Uuid
  tenantId          String          @db.Uuid
  branchId          String          @db.Uuid
  cashierId         String          @db.Uuid
  currency          String
  status            CashShiftStatus @default(OPEN)
  openedAt          DateTime        @default(now())
  openingFloatMinor BigInt
  closedAt          DateTime?
  expectedCashMinor BigInt?
  countedCashMinor  BigInt?
  differenceMinor   BigInt?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch   Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  payments Payment[]
  refunds  Refund[]

  @@index([tenantId, branchId, openedAt])
}

enum ExpenseCategory {
  SALARY
  RENT
  UTILITIES
  MEDICAL_SUPPLIES
  EQUIPMENT
  TAXES
  MARKETING
  OTHER
}

model Expense {
  id          String          @id @db.Uuid
  tenantId    String          @db.Uuid
  branchId    String?         @db.Uuid
  category    ExpenseCategory
  amountMinor BigInt
  currency    String
  spentOn     DateTime        @db.Date
  description String?
  createdById String          @db.Uuid
  createdAt   DateTime        @default(now())
  voidedAt    DateTime?

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([tenantId, spentOn])
}

// ───────────────────────────── Laboratory (Phase 8a) ──────────────────────────

/// A measured component of a lab test (service of kind LAB_TEST), e.g. "Hemoglobin".
/// Reference ranges are clinic-configured and snapshotted into each result.
model LabAnalyte {
  id         String    @id @db.Uuid
  tenantId   String    @db.Uuid
  serviceId  String    @db.Uuid
  name       String
  /// LOINC code when known (for future FHIR exchange).
  loinc      String?
  unit       String
  refLow     Decimal?  @db.Decimal(12, 4)
  refHigh    Decimal?  @db.Decimal(12, 4)
  sortOrder  Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  service Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  results LabResult[]

  @@index([tenantId, serviceId])
}

enum LabOrderStatus {
  ORDERED
  COLLECTED
  RESULTED
  VERIFIED
  CANCELLED
}

enum LabPriority {
  ROUTINE
  URGENT
}

model LabOrder {
  id              String         @id @db.Uuid
  tenantId        String         @db.Uuid
  /// Specimen label / order number: LAB-<year>-<6 digits>, per clinic and year.
  number          String
  patientId       String         @db.Uuid
  encounterId     String?        @db.Uuid
  doctorProfileId String         @db.Uuid
  branchId        String         @db.Uuid
  status          LabOrderStatus @default(ORDERED)
  priority        LabPriority    @default(ROUTINE)
  /// Clinical indication for the lab (visible to lab staff).
  indication      String?
  orderedById     String         @db.Uuid
  orderedAt       DateTime       @default(now())
  collectedAt     DateTime?
  collectedById   String?        @db.Uuid
  resultedAt      DateTime?
  resultedById    String?        @db.Uuid
  verifiedAt      DateTime?
  verifiedById    String?        @db.Uuid
  cancelledAt     DateTime?
  /// Set by the doctor when verified results may be shown in the patient portal (one-way).
  releasedAt      DateTime?
  releasedById    String?        @db.Uuid

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient   Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter Encounter?     @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  doctor    DoctorProfile  @relation(fields: [doctorProfileId], references: [id], onDelete: Restrict)
  branch    Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  items     LabOrderItem[]

  @@unique([tenantId, number])
  @@index([tenantId, status, orderedAt])
  @@index([tenantId, patientId])
}

model LabOrderItem {
  id        String @id @db.Uuid
  tenantId  String @db.Uuid
  orderId   String @db.Uuid
  serviceId String @db.Uuid
  /// Snapshot of the test name.
  name      String

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  order   LabOrder    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  service Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  results LabResult[]

  @@index([tenantId, orderId])
}

enum LabFlag {
  NORMAL
  LOW
  HIGH
}

/// One analyte value. Locked once the order is VERIFIED (trigger).
model LabResult {
  id          String   @id @db.Uuid
  tenantId    String   @db.Uuid
  orderItemId String   @db.Uuid
  analyteId   String   @db.Uuid
  value       Decimal  @db.Decimal(12, 4)
  unit        String
  refLow      Decimal? @db.Decimal(12, 4)
  refHigh     Decimal? @db.Decimal(12, 4)
  flag        LabFlag
  enteredById String   @db.Uuid
  enteredAt   DateTime @default(now())

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  item    LabOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  analyte LabAnalyte   @relation(fields: [analyteId], references: [id], onDelete: Restrict)

  @@unique([orderItemId, analyteId])
  @@index([tenantId])
}

// ───────────── Patient portal (Phase 8b) ─────────────

enum PortalAccountStatus {
  INVITED
  ACTIVE
  DISABLED
}

/// Patient portal login: a separate identity realm from staff (User). One per
/// patient per clinic. Created by the front desk with a one-time activation
/// code handed to the patient in person; only the SHA-256 of the code is stored.
model PatientAccount {
  id                  String              @id @db.Uuid
  tenantId            String              @db.Uuid
  patientId           String              @unique @db.Uuid
  /// Login phone (+998…), chosen by the patient at activation; unique per clinic.
  login               String?
  passwordHash        String?
  status              PortalAccountStatus @default(INVITED)
  activationCodeHash  String?             @unique
  activationExpiresAt DateTime?
  activatedAt         DateTime?
  failedLoginCount    Int                 @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  locale              String?
  createdById         String              @db.Uuid
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient  Patient          @relation(fields: [patientId], references: [id], onDelete: Restrict)
  sessions PatientSession[]

  @@unique([tenantId, login])
  @@index([tenantId])
}

/// Patient portal session. id = SHA-256 of the cookie token.
model PatientSession {
  id         String    @id
  tenantId   String    @db.Uuid
  accountId  String    @db.Uuid
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  ipHash     String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  account PatientAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId])
  @@index([tenantId])
}

// ───────────── Pharmacy & inventory (Phase 8c) ─────────────

enum InventoryCategory {
  MEDICINE
  CONSUMABLE
  REAGENT
  EQUIPMENT
  OTHER
}

/// Catalogue entry. Quantities are whole dispensing units (tablet, ampoule, piece, pack).
model InventoryItem {
  id         String            @id @db.Uuid
  tenantId   String            @db.Uuid
  code       String
  name       String
  category   InventoryCategory @default(MEDICINE)
  /// Dosage form and strength as printed on the pack, e.g. "tablet", "500 mg".
  form       String?
  strength   String?
  /// Dispensing unit key: pcs, pack, ml, ampoule, vial, g.
  unit       String
  /// Reorder level per branch, in units. 0 = no alert.
  minStock   Int               @default(0)
  barcode    String?
  archivedAt DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  batches   StockBatch[]
  movements StockMovement[]

  @@unique([tenantId, code])
  @@index([tenantId, name])
}

model Supplier {
  id         String    @id @db.Uuid
  tenantId   String    @db.Uuid
  name       String
  taxId      String?
  phone      String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  batches StockBatch[]

  @@unique([tenantId, name])
}

/// One received lot of an item at a branch. quantity is maintained ONLY by the
/// database from the StockMovement ledger (trigger) and can never go negative.
model StockBatch {
  id            String    @id @db.Uuid
  tenantId      String    @db.Uuid
  itemId        String    @db.Uuid
  branchId      String    @db.Uuid
  supplierId    String?   @db.Uuid
  lotNumber     String
  expiresOn     DateTime? @db.Date
  quantity      Int       @default(0)
  unitCostMinor BigInt?
  currency      String    @default("UZS")
  receivedAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  item      InventoryItem   @relation(fields: [itemId], references: [id], onDelete: Restrict)
  branch    Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier  Supplier?       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  movements StockMovement[]

  @@index([tenantId, branchId, itemId])
  @@index([tenantId, expiresOn])
}

enum StockMovementKind {
  RECEIPT
  ISSUE
  DISPENSE
  ADJUSTMENT
  WRITE_OFF
}

enum StockReason {
  COUNT_CORRECTION
  EXPIRED
  DAMAGED
  LOST
  RECALLED
  OTHER
}

/// Append-only stock ledger. Positive = stock in (receipt, adjustment up), negative = stock out.
model StockMovement {
  id           String            @id @db.Uuid
  tenantId     String            @db.Uuid
  batchId      String            @db.Uuid
  itemId       String            @db.Uuid
  branchId     String            @db.Uuid
  kind         StockMovementKind
  quantity     Int
  reason       StockReason?
  /// DISPENSE only: the patient who received it (clinical data, no platform access).
  patientId    String?           @db.Uuid
  /// ISSUE only: internal consumer (department).
  departmentId String?           @db.Uuid
  /// Supplier invoice or waybill number for receipts.
  documentRef  String?
  createdById  String            @db.Uuid
  createdAt    DateTime          @default(now())

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  batch   StockBatch    @relation(fields: [batchId], references: [id], onDelete: Restrict)
  item    InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  branch  Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient Patient?      @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([tenantId, itemId, createdAt])
  @@index([tenantId, patientId])
}

// ───────────── HR (Phase 8c) ─────────────

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

/// HR data for a clinic member. Deliberately minimal: no home address, passport or health data.
model StaffProfile {
  id              String         @id @db.Uuid
  tenantId        String         @db.Uuid
  membershipId    String         @unique @db.Uuid
  personnelNumber String?
  position        String?
  departmentId    String?        @db.Uuid
  employmentType  EmploymentType @default(FULL_TIME)
  hiredOn         DateTime?      @db.Date
  workPhone       String?
  updatedById     String         @db.Uuid
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membership Membership  @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([tenantId, personnelNumber])
  @@index([tenantId])
}

enum CredentialKind {
  MEDICAL_LICENSE
  SPECIALIST_CERTIFICATE
  QUALIFICATION_CATEGORY
  TRAINING
  OTHER
}

/// Licences and certificates with expiry tracking.
model StaffCredential {
  id           String         @id @db.Uuid
  tenantId     String         @db.Uuid
  membershipId String         @db.Uuid
  kind         CredentialKind
  title        String
  number       String?
  issuer       String?
  issuedOn     DateTime?      @db.Date
  expiresOn    DateTime?      @db.Date
  archivedAt   DateTime?
  createdById  String         @db.Uuid
  createdAt    DateTime       @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Restrict)

  @@index([tenantId, expiresOn])
  @@index([tenantId, membershipId])
}

/// Category only: never diagnoses or other health details about employees.
enum LeaveKind {
  VACATION
  SICK_LEAVE
  TRAINING
  UNPAID
  OTHER
}

enum LeaveStatus {
  APPROVED
  CANCELLED
}

model StaffLeave {
  id           String      @id @db.Uuid
  tenantId     String      @db.Uuid
  membershipId String      @db.Uuid
  kind         LeaveKind
  startsOn     DateTime    @db.Date
  endsOn       DateTime    @db.Date
  status       LeaveStatus @default(APPROVED)
  createdById  String      @db.Uuid
  cancelledAt  DateTime?
  createdAt    DateTime    @default(now())

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membership Membership          @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  daysOff    ScheduleException[]

  @@index([tenantId, startsOn])
  @@index([tenantId, membershipId])
}

// ───────────── Notifications (Phase 8d) ─────────────

enum NotificationChannel {
  SMS
  EMAIL
  TELEGRAM
}

enum NotificationKind {
  APPOINTMENT_BOOKED
  APPOINTMENT_REMINDER
  APPOINTMENT_CANCELLED
  RESULTS_READY
  /// The day before a dispensary patient's follow-up is due (no clinical content in the message).
  DISPENSARY_REMINDER
  /// The patient missed a visit: an offer to book again (portal link / clinic phone).
  NO_SHOW_REBOOK
  /// N days after a visit: "how are you feeling?" with answer buttons (Telegram only).
  VISIT_CHECKIN
  /// Medicine intake time from the prescription schedule (Telegram only; the medicine is not named).
  MEDICATION_REMINDER
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

/// Outbox. Stores WHAT to tell WHOM and WHEN — never the text, the address or
/// clinical content. Text is rendered at send time from templates; recipient
/// and consent are re-checked at send time.
model Notification {
  id        String              @id @db.Uuid
  tenantId  String              @db.Uuid
  patientId String              @db.Uuid
  channel   NotificationChannel
  kind      NotificationKind
  status    NotificationStatus  @default(PENDING)
  /// The appointment or lab order the message is about.
  subjectId String?             @db.Uuid
  dueAt     DateTime
  attempts  Int                 @default(0)
  /// Short machine code only (e.g. "no_consent", "smtp_failed"), never message content.
  lastError String?
  /// Transport used: "smtp", "dev-mailbox" (simulated), "sms-dev-outbox" (simulated).
  transport String?
  sentAt    DateTime?
  /// One message per kind, subject and channel.
  dedupeKey String
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, status, dueAt])
  @@index([tenantId, createdAt])
}

/// Per-clinic notification switches (row created on first save; defaults apply until then).
model NotificationSettings {
  tenantId             String   @id @db.Uuid
  appointmentBooked    Boolean  @default(true)
  appointmentReminder  Boolean  @default(true)
  reminderHoursBefore  Int      @default(24)
  appointmentCancelled Boolean  @default(true)
  resultsReady         Boolean  @default(true)
  /// Offer a patient who missed a visit to book again.
  noShowRebook         Boolean  @default(true)
  /// Ask "how are you feeling?" this many days after a visit (Telegram).
  visitCheckIn         Boolean  @default(true)
  checkInDays          Int      @default(5)
  /// Telegram reminders at the intake times of prescriptions.
  medicationReminders  Boolean  @default(true)
  updatedById          String   @db.Uuid
  updatedAt            DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
}

// ───────────── Practice profiles & dentistry (Phase 8e) ─────────────

/// What kind of practice the clinic is; drives the setup presets (modules, starter services).
enum DataMode {
  LOCAL
  CONNECTED
}

enum PracticeType {
  MULTI_SPECIALTY
  SOLO_PRACTICE
  DENTAL
  DIAGNOSTIC
  OTHER
}

enum ToothCondition {
  HEALTHY
  CARIES
  FILLED
  CROWN
  ROOT_CANAL
  IMPLANT
  MISSING
  TO_EXTRACT
}

/// Dental chart (odontogram). Append-only: the latest entry per tooth is the
/// current state; corrections are new entries. Teeth use FDI numbering.
model DentalChartEntry {
  id           String         @id @db.Uuid
  tenantId     String         @db.Uuid
  patientId    String         @db.Uuid
  encounterId  String?        @db.Uuid
  /// FDI two-digit tooth number: 11–48 permanent teeth, 51–85 primary teeth.
  tooth        Int
  /// Affected surfaces: M mesial, O occlusal/incisal, D distal, B buccal/labial, L lingual/palatal.
  surfaces     String[]
  condition    ToothCondition
  recordedById String         @db.Uuid
  recordedAt   DateTime       @default(now())

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter Encounter? @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  @@index([tenantId, patientId, tooth, recordedAt])
}

// ───────────── Rate limiting (Phase 9) ─────────────

/// Shared fixed-window counters for all app instances. UNLOGGED (see
/// migration): fast, and losing counters on a crash is acceptable. Keys are
/// SHA-256 hashes — no emails or IP hashes in clear. Accessed only through
/// rate_limit_hit(); no table grants.
model RateLimitBucket {
  key         String   @id
  windowEndAt DateTime
  count       Int

  @@index([windowEndAt])
  @@ignore
}

// ───────────────────────────── Clinic control policy ────────────────────────

/// Owner-defined control rules of a clinic (one row per clinic, created on first save).
model ClinicPolicy {
  tenantId                 String    @id @db.Uuid
  /// Highest discount (percent of a line) anyone except the clinic owner may give. 100 = no limit.
  maxDiscountPercent       Int       @default(100)
  /// A written reason is required for every discount.
  discountReasonRequired   Boolean   @default(false)
  /// Patient portal self-booking: how many days ahead patients may book.
  onlineBookingDays        Int       @default(30)
  /// Earliest online booking, in minutes from now.
  onlineBookingLeadMinutes Int       @default(120)
  /// Most future online visits one patient may hold at once (abuse protection).
  onlineBookingMaxActive   Int       @default(3)
  /// Where the clinic works: LOCAL = only on this computer, nothing is sent over the internet
  /// (patient messages off). Null = the default of the installation (local app: LOCAL).
  dataMode                 DataMode?
  /// Local app only: keep one Excel file per patient in a folder on this computer.
  patientFilesEnabled      Boolean   @default(false)
  patientFilesDir          String?
  /// Who turned the files on (needs oversight access to medical records).
  patientFilesEnabledById  String?   @db.Uuid
  patientFilesSyncedAt     DateTime?
  /// A repeat consultation within this many days of the first (paid) one is free. 0 = off.
  freeFollowUpDays         Int       @default(10)
  updatedById              String?   @db.Uuid
  updatedAt                DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
}

// ───────────────────────────── Prescriptions ─────────────────────────────────

enum PrescriptionStatus {
  ACTIVE
  CANCELLED
}

/// A medication prescribed during a visit. Immutable once written: mistakes are cancelled, not edited.
model Prescription {
  id              String             @id @db.Uuid
  tenantId        String             @db.Uuid
  patientId       String             @db.Uuid
  encounterId     String             @db.Uuid
  prescribedById  String             @db.Uuid
  /// Medicine name (international non-proprietary name or trade name) and strength, e.g. "Bisoprolol 5 mg".
  drug            String
  /// International non-proprietary name (INN), printed in brackets after a trade name so the
  /// pharmacy can dispense an equivalent, e.g. drug "Trombonet 75 mg", inn "klopidogrel".
  inn             String?
  /// e.g. "1 tablet"
  dose            String
  /// e.g. "once daily in the morning"
  frequency       String
  /// e.g. "by mouth"
  route           String?
  durationDays    Int?
  /// Intake times, e.g. "08:00, 20:00" (printed as a schedule).
  times           String?
  instructions    String?
  /// The prescriber confirmed despite a recorded allergy that matches the medicine.
  allergyOverride Boolean            @default(false)
  status          PrescriptionStatus @default(ACTIVE)
  cancelledAt     DateTime?
  cancelledById   String?            @db.Uuid
  createdAt       DateTime           @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  @@index([tenantId, patientId])
  @@index([encounterId])
}

// ───────────────────────────── Telegram ─────────────────────────────────────

/// The clinic's own Telegram bot (created with @BotFather). The token is a secret: AES-GCM encrypted, never shown again.
model TelegramBot {
  tenantId       String   @id @db.Uuid
  tokenEnc       String
  username       String
  enabled        Boolean  @default(true)
  /// Last processed getUpdates id + 1.
  updateOffset   BigInt   @default(0)
  /// Login Widget client secret of this bot (AES-GCM, clinic-bound); null = no Telegram sign-in on /login/<slug>.
  loginSecretEnc String?
  connectedAt    DateTime @default(now())
  updatedById    String?  @db.Uuid
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
}

/// A patient's Telegram chat, linked by the patient themself (portal → bot deep link).
model TelegramLink {
  id        String    @id @db.Uuid
  tenantId  String    @db.Uuid
  patientId String    @db.Uuid
  chatId    BigInt
  linkedAt  DateTime  @default(now())
  revokedAt DateTime?
  /// The patient pressed "stop" under a medicine reminder in this chat.
  medRemindersOff Boolean @default(false)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([tenantId, patientId])
}

/// One-time code in the bot deep link (only its SHA-256 is stored).
model TelegramLinkCode {
  codeHash  String    @id
  tenantId  String    @db.Uuid
  patientId String    @db.Uuid
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([tenantId])
}

// ───────────────────────────── Clinic templates ─────────────────────────────

enum TemplateKind {
  /// Pre-filled sections of a doctor's visit note.
  NOTE
  /// A printable document (visit summary, referral, certificate…) with placeholders.
  DOCUMENT
  /// A diagnostic report (UZI, echo, ECG…): fields with the clinic's normal ranges + report text.
  DIAGNOSTIC
  /// A ready-made prescription scheme: the doctor's medicines for a typical case, applied to a visit in one step.
  PRESCRIPTION
}

/// Templates the clinic creates itself. Generic text only — never patient data.
model ClinicTemplate {
  id          String       @id @db.Uuid
  tenantId    String       @db.Uuid
  kind        TemplateKind
  name        String
  /// Optional: show only to doctors of this specialty (key from specialties.ts).
  specialty   String?
  /// NOTE: JSON object of note sections. DOCUMENT: text with {{placeholders}}.
  content     String
  createdById String       @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  archivedAt  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, kind])
}

/// Phone number Telegram verified for a Telegram user (shared with the central
/// bot by that person). No runtime role has grants: only the SECURITY DEFINER
/// functions tg_contact_save / tg_contact_known / portal_telegram_accounts.
model TelegramContact {
  telegramId BigInt   @id
  phone      String
  verifiedAt DateTime @default(now())

  @@index([phone])
}

// ───────────────────────────── ITop Med billing of clinics ─────────────────────

enum PlatformPaymentMethod {
  CASH
  TRANSFER
  CARD
  OTHER
}

/// Monthly subscription invoice of a clinic (made from its plan price; one per month).
model ClinicInvoice {
  id          String    @id @db.Uuid
  tenantId    String    @db.Uuid
  number      String    @unique
  periodStart DateTime  @db.Date
  periodEnd   DateTime  @db.Date
  amountMinor BigInt
  currency    String    @default("UZS")
  dueDate     DateTime  @db.Date
  voidedAt    DateTime?
  createdAt   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, periodStart])
  @@index([tenantId])
}

/// A payment from a clinic to ITop Med, entered by the SuperAdmin. Settles the oldest invoices first.
model ClinicPayment {
  id           String                @id @db.Uuid
  tenantId     String                @db.Uuid
  amountMinor  BigInt
  currency     String                @default("UZS")
  method       PlatformPaymentMethod
  receivedOn   DateTime              @db.Date
  note         String?
  recordedById String                @db.Uuid
  voidedAt     DateTime?
  createdAt    DateTime              @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
}

/// One row (id = 1): when invoices fall due and when an overdue clinic is suspended.
model BillingSettings {
  id               Int      @id @default(1)
  dueDays          Int      @default(10)
  suspendAfterDays Int      @default(15)
  autoSuspend      Boolean  @default(true)
  updatedAt        DateTime @default(now()) @updatedAt
}

/// Long-term follow-up groups ("dispanser kuzatuvi") the doctor puts a patient in.
enum DispensaryGroup {
  HYPERTENSION
  HEART_FAILURE
  ATRIAL_FIBRILLATION
  POST_MI
  ANTICOAGULANT
  OTHER
}

/// A patient under the doctor's long-term follow-up: how often to come, when next, which tests.
model DispensaryPlan {
  id              String          @id @db.Uuid
  tenantId        String          @db.Uuid
  patientId       String          @db.Uuid
  /// Responsible doctor.
  doctorProfileId String          @db.Uuid
  group           DispensaryGroup
  /// Follow-up every N days (7–365).
  intervalDays    Int
  /// Local date of the next follow-up visit.
  nextDueDate     DateTime        @db.Date
  /// Tests to repeat, in the doctor's words (e.g. "Koagulogramma (INR)").
  labs            String?
  note            String?
  createdById     String          @db.Uuid
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  /// Last time the doctor marked a follow-up visit done.
  lastSeenAt      DateTime?
  closedAt        DateTime?
  closedById      String?         @db.Uuid

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor  DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Restrict)

  @@index([tenantId, doctorProfileId, nextDueDate])
  @@index([tenantId, patientId])
}

// ───────────── Patient-reported measurements & visit check-ins (Telegram) ─────────────

enum ReadingSource {
  TELEGRAM
  PORTAL
}

/// Blood pressure and pulse the patient measured at home and sent (bot message or portal).
/// Patient-reported and append-only; shown to staff with record access.
model PatientReading {
  id         String        @id @db.Uuid
  tenantId   String        @db.Uuid
  patientId  String        @db.Uuid
  systolic   Int
  diastolic  Int
  pulse      Int?
  measuredAt DateTime
  source     ReadingSource
  createdAt  DateTime      @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([tenantId, patientId, measuredAt])
}

enum CheckInAnswer {
  BETTER
  SAME
  WORSE
}

/// "How are you feeling?" a few days after a visit; the patient answers with a bot button.
model VisitCheckIn {
  id              String         @id @db.Uuid
  tenantId        String         @db.Uuid
  patientId       String         @db.Uuid
  encounterId     String         @unique @db.Uuid
  doctorProfileId String         @db.Uuid
  askAt           DateTime
  answer          CheckInAnswer?
  answeredAt      DateTime?
  createdAt       DateTime       @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  @@index([tenantId, doctorProfileId, answeredAt])
}
